<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.btcn.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/l/btcn/scripts/run_daily_guard.sh</string>
    </array>

    <!-- 매시간 체크: Mac이 언제 깨어나든 당일 학습을 보장 -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- 부팅/로그인 후 즉시 한 번 체크 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/l/btcn/data/logs/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/l/btcn/data/logs/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/l/btcn</string>
</dict>
</plist>
